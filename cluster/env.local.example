# The site values of the cluster the jobs run on. Copy this file to cluster/env.local
# (untracked: .gitignore keeps it out of git) and fill in the real values; the repository
# itself names no account, host or endpoint. ACTIVATE.md sources it in the login shell;
# the sbatch jobs that download or call the endpoint source it themselves.

# The Slurm account the jobs are charged to. sbatch reads SBATCH_ACCOUNT from the
# submitting shell, so no #SBATCH line names an account.
export SBATCH_ACCOUNT=my_account

# The HTTP(S) proxy through which compute nodes reach the internet ("" if none needed).
# A job exports it as https_proxy/http_proxy only where it downloads or calls the endpoint.
export CLUSTER_PROXY=http://proxy.example.org:3128

# The OpenAI-compatible endpoint (/chat/completions and /embeddings) of the LLM methods,
# the discipline step and the embed scorer, and its API key. The key may instead be put
# into config/llm_credentials.toml (one line: api_key = "..."); empty here, that file is read.
export LLM_API_BASE=https://example.org/v1
export LLM_API_KEY=
